DASHBOARD_DB_PATH=dashboard/data/cluster.db
DASHBOARD_POLL_BASE_SECONDS=2
DASHBOARD_HTTP_TIMEOUT_SECONDS=4
DASHBOARD_AGENT_DEFAULT_PORT=8001
DASHBOARD_ENROLL_SECRET=changeme-enroll
DASHBOARD_TOKEN_TTL_SECONDS=86400
DASHBOARD_TOKEN_GRACE_SECONDS=300
DASHBOARD_POLL_FAILURE_THRESHOLD=3
DASHBOARD_POLL_CIRCUIT_COOLDOWN_SECONDS=60
DASHBOARD_METRIC_RETENTION_HOURS=48
DASHBOARD_ALERT_RETENTION_DAYS=14
DASHBOARD_SERVICE_RETENTION_DAYS=7
DASHBOARD_CLEANUP_INTERVAL_SECONDS=300
DASHBOARD_WEBHOOK_URL=
DASHBOARD_WEBHOOK_TIMEOUT_SECONDS=3
DASHBOARD_WEBHOOK_RETRY_BASE_SECONDS=15
DASHBOARD_WEBHOOK_MAX_ATTEMPTS=5
DASHBOARD_WEBHOOK_DISPATCH_INTERVAL_SECONDS=5
# Key used to encrypt node bearer tokens at rest (required for secret-at-rest hardening).
DASHBOARD_NODE_TOKEN_KEY=replace-with-32plus-random-characters
# Format: token:principal:role[:expires_at_epoch_or_iso][:status]
DASHBOARD_OPERATOR_CREDENTIALS=admin-token:alice-admin:admin::active,operator-token:bob-operator:operator::active,viewer-token:victor-viewer:viewer::active
DASHBOARD_OPERATOR_AUTH_WINDOW_SECONDS=60
DASHBOARD_OPERATOR_AUTH_MAX_FAILURES=5
DASHBOARD_OPERATOR_AUTH_LOCKOUT_SECONDS=120