[Unit]
Description=Pi Node Agent
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pi-cluster-monitor/agent
EnvironmentFile=/etc/pi-cluster/agent.env
ExecStart=/opt/pi-cluster-monitor/agent/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
