[Unit]
Description=Pi Cluster Dashboard
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pi-cluster-monitor/dashboard
EnvironmentFile=/etc/pi-cluster/dashboard.env
ExecStart=/opt/pi-cluster-monitor/dashboard/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
